# Copy to .env and insert your OpenRouter key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Pin a version for reproducible benchmarks.
JEV_MODEL=typesafe/jev-1.13
# To automatically follow the newest Jev release instead:
# JEV_MODEL=~typesafe/jev-latest

OCR_LANGUAGES=eng+deu
SAME_DOCUMENT_THRESHOLD=0.75

BENCHMARK_STACKS=8
BENCHMARK_DOCUMENTS_PER_STACK=4
BENCHMARK_SEED=42
BENCHMARK_MODE=mixed
